<clickhouse>
    <!--
      Restore network listeners (previously provided by docker_related_config.xml,
      which this directory replaces when bind-mounted).
    -->
    <listen_host>::</listen_host>
    <listen_host>0.0.0.0</listen_host>
    <listen_try>1</listen_try>

    <!--
      Reduce CPU pressure from system metric logging.

      Diagnosis (see AGENTS.md / docker-compose): when the stack is idle the
      dominant CPU consumer was system.asynchronous_metric_log, which stored one
      row per async metric (~211 metrics) every second -> ~18M rows/day, creating
      hundreds of tiny parts that drive constant background merges.

      Fixes:
      1. Raise the async metric update period from 1s to 60s (~60x less data).
      2. Disable the least-useful, high-volume system logs (remove="1").
      3. Keep query_log (query history is useful for debugging) and part_log
         (valuable when diagnosing merge storms like this one).
      4. Silence trace_log by disabling the sampling profilers (they generated
         ~1.4M rows in <1 hour).

      NOTE: remove="1" stops writes but leaves existing tables on disk. The
      old tables must be dropped manually, otherwise the disk/data stays.
    -->

    <asynchronous_metrics_update_period_s>60</asynchronous_metrics_update_period_s>

    <asynchronous_metric_log>
        <database>system</database>
        <table>asynchronous_metric_log</table>
        <flush_interval_milliseconds>60000</flush_interval_milliseconds>
        <max_size_rows>1048576</max_size_rows>
        <reserved_size_rows>8192</reserved_size_rows>
        <buffer_size_rows_flush_threshold>524288</buffer_size_rows_flush_threshold>
        <flush_on_crash>false</flush_on_crash>
    </asynchronous_metric_log>

    <metric_log remove="1"/>

    <query_thread_log remove="1"/>

    <query_views_log remove="1"/>

    <text_log remove="1"/>

    <processors_profile_log remove="1"/>

    <!-- Trace log is driven by the sampling query profilers; disable it. -->
    <trace_log remove="1"/>

    <!-- Keep query_log enabled but reduce write frequency. -->
    <query_log>
        <database>system</database>
        <table>query_log</table>
        <flush_interval_milliseconds>60000</flush_interval_milliseconds>
        <max_size_rows>1048576</max_size_rows>
        <reserved_size_rows>8192</reserved_size_rows>
        <buffer_size_rows_flush_threshold>524288</buffer_size_rows_flush_threshold>
        <flush_on_crash>false</flush_on_crash>
    </query_log>
</clickhouse>